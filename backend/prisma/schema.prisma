// Prisma 7 schema for Paper Todo. The connection URL lives in prisma.config.ts.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  color     String
  createdAt DateTime        @default(now())
  tasks     Task[]
  events    CalendarEvent[]
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  notes       String     @default("")
  projectId   String?    @db.Uuid
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  completedAt DateTime?
  archived    Boolean    @default(false)
  pinned      Boolean    @default(false)
  repeatRule  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtasks    Subtask[]
  reminders   Reminder[]

  @@index([dueAt])
  @@index([status, archived])
}

model Subtask {
  id       String  @id @default(uuid()) @db.Uuid
  taskId   String  @db.Uuid
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title    String
  done     Boolean @default(false)
  position Int     @default(0)

  @@index([taskId])
}

/// How an alert shows up: an ordinary notification (Done / Snooze) or an alarm that takes over the screen.
enum AlertStyle {
  NOTIFICATION
  ALARM
}

model Reminder {
  id              String    @id @default(uuid()) @db.Uuid
  taskId          String?   @db.Uuid
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  eventId         String?   @db.Uuid
  event           CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title           String
  remindAt        DateTime
  repeatRule      String?
  locationTrigger String?
  /// NOTIFICATION: an ordinary notification with Done and Snooze. ALARM: rings and takes over the screen.
  style           AlertStyle @default(ALARM)
  enabled         Boolean   @default(true)
  snoozedUntil    DateTime?
  createdAt       DateTime  @default(now())

  @@index([remindAt])
  @@index([eventId])
}

model Habit {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  habitId String   @db.Uuid
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  @@id([habitId, date])
}

model CalendarEvent {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  startAt   DateTime
  endAt     DateTime
  allDay    Boolean  @default(false)
  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location  String?
  videoLink String?
  /// "Show as": busy blocks the time on a shared calendar, free does not.
  busy      Boolean  @default(true)
  guests    String[] @default([])
  createdAt DateTime @default(now())
  reminders Reminder[]

  @@index([startAt])
}

model DailyNote {
  date      DateTime @id @db.Date
  text      String   @default("")
  updatedAt DateTime @updatedAt
}
