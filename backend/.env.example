# Copy to .env. Databases live in your local PostgreSQL (browse them with pgAdmin).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://etech@localhost:5432/paper_todo?schema=public

# AI features (Grok by xAI). Optional: leave the key empty and AI screens say "not set up".
# Get a key at https://console.x.ai and paste it here. Never commit it.
XAI_API_KEY=
# XAI_MODEL=grok-4.7
# Any OpenAI-compatible provider works, e.g. Groq (key starts with gsk_):
#   XAI_BASE_URL=https://api.groq.com/openai/v1   XAI_MODEL=openai/gpt-oss-120b
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_MS=60000
